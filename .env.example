BRAVE_API_KEY=your_brave_data_for_ai_key_here
PORT=8080
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=masterKey
QDRANT_URL=http://localhost:6333
SEARXNG_URL=http://localhost:8888
LLAMACPP_URL=
CORPUS_FIRST=true
CRAWL_CONCURRENCY=3
CRAWL_TIMEOUT_MS=60000
OBSIDIAN_VAULT_PATH=           # Optional: path to Obsidian vault for auto-sync
SWEEP_CONCURRENCY=6            # Max parallel queries in sweep (Brave rate limit: 6)

# Phase A — Academic backend (arxiv + PubMed + Semantic Scholar)
QSEARCH_ACADEMIC_ENABLED=true  # Set to "false" to disable academic routing for domain=scholarly
NCBI_API_KEY=                  # Optional: PubMed E-utilities key (raises rate 3→10 req/s)
SEMANTIC_SCHOLAR_API_KEY=      # Optional: free key from semanticscholar.org/product/api (avoids 429s)

# Phase B — Local rerank pipeline (embedding similarity + optional LLM scoring)
QSEARCH_RERANK_ENABLED=false   # Default off — flip to true after dogfooding
QSEARCH_RERANK_STAGE2_PRIORITIES=critical  # Comma list: which priorities trigger LLM rerank
QSEARCH_RERANK_TOP_N_PER_QUERY=10
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text  # `ollama pull nomic-embed-text` (one-time 274MB)

# Phase C — RU coverage. Currently via SearXNG language=ru-RU bias (Google/DDG
# returning RU sites — tadviser, vc, habr, rbc). Yandex engine in SearXNG is
# broken upstream ("parsing error"). For direct Yandex XML Search API integration
# later: sign up Yandex Cloud → Search API service account → get folder_id +
# api-key, then YANDEX_API_KEY + YANDEX_FOLDER_ID become routing inputs.
