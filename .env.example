BRAVE_API_KEY=your_brave_data_for_ai_key_here
PORT=8080
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=masterKey
QDRANT_URL=http://localhost:6333
SEARXNG_URL=http://localhost:8888
LLAMACPP_URL=
CORPUS_FIRST=true
CRAWL_CONCURRENCY=3
CRAWL_TIMEOUT_MS=60000
OBSIDIAN_VAULT_PATH=           # Optional: path to Obsidian vault for auto-sync
SWEEP_CONCURRENCY=6            # Max parallel queries in sweep (Brave rate limit: 6)

# Phase A — Academic backend (arxiv + PubMed + Semantic Scholar)
QSEARCH_ACADEMIC_ENABLED=true  # Set to "false" to disable academic routing for domain=scholarly
NCBI_API_KEY=                  # Optional: PubMed E-utilities key (raises rate 3→10 req/s)
SEMANTIC_SCHOLAR_API_KEY=      # Optional: free key from semanticscholar.org/product/api (avoids 429s)

# Phase B — Local rerank pipeline (embedding similarity + optional LLM scoring)
QSEARCH_RERANK_ENABLED=false   # Default off — flip to true after dogfooding
QSEARCH_RERANK_STAGE2_PRIORITIES=critical  # Comma list: which priorities trigger LLM rerank
QSEARCH_RERANK_TOP_N_PER_QUERY=10

# Layer 8 — composite quality gate (rejection threshold).
# OFF by default — flip after dogfooding threshold + weights on real sprints.
# Target ~60-75% rejection rate per ARCHITECTURE.md.
QSEARCH_QUALITY_GATE_ENABLED=false
QSEARCH_QUALITY_THRESHOLD=0.4
# QSEARCH_QUALITY_WEIGHTS={"emb":0.4,"auth":0.3,"llm":0.2,"trust":0.1}
# QSEARCH_QUALITY_AUTHORITY={"nature.com":1.0,"medium.com":0.35}
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text  # `ollama pull nomic-embed-text` (one-time 274MB)

# Phase C — RU coverage.
# Direct Yandex Cloud Search API (XML): https://yandex.cloud/en/docs/search-api/
# Sign up Yandex Cloud → create folder → Search API service account → API key.
# When both are set, domain=ru queries route to Yandex first, fallback SearXNG
# with language=ru-RU bias. Without keys → SearXNG ru-RU only (also works).
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# YANDEX_BASE_URL=https://yandex.com/search/xml  # optional override (.ru also works)

# ── Tier 0 hardening (2026-06-23) — required before any non-loopback exposure ──
QSEARCH_BIND=127.0.0.1         # Bind address. Loopback = no auth needed. Non-loopback REQUIRES auth below.
# QSEARCH_API_KEY=             # Required when QSEARCH_BIND is non-loopback. `openssl rand -hex 32`. Clients send X-API-Key or Authorization: Bearer.
# QSEARCH_IP_ALLOWLIST=        # Alternative/extra to the key: semicolon-separated IPs allowed without a key (e.g. "10.0.0.5;10.0.0.6").
QSEARCH_TRUST_PROXY=false      # Set true ONLY behind a reverse proxy to honor X-Forwarded-For for IP allowlisting.
QSEARCH_MAX_BODY_BYTES=10485760 # Max POST body (10MB). Larger requests get 413.
# QSEARCH_RATE_LIMIT_ENABLED=true # Force rate limiting on loopback too (it is always on when non-loopback).
# QSEARCH_RATE_LIMITS=/index=10,/sweep_context=20,/search=100,/sweep=30  # Per-route requests/window. Override defaults.
QSEARCH_RATE_WINDOW_MS=60000   # Rate-limit window.
QSEARCH_HEALTH_REQUIRE_CORPUS=false # When true, GET /health?deep=1 returns 503 if Meilisearch is unreachable.

# ── Tier 1 — sweep robustness ──
QSEARCH_SWEEP_QUERY_TIMEOUT_MS=0 # Per-query deadline (frees the slot when a backend hangs). 0=off. Recommended 20000-30000 once dogfooded.
QSEARCH_SWEEP_ZERO_RETRIES=1   # Zero-result retries (exponential backoff).
QSEARCH_SWEEP_RETRY_BASE_MS=800 # First backoff delay; doubles each retry.

# ── Tier 2 — trust formula ──
QSEARCH_TRUST_DECAY_K=0         # Recency decay: trust *= exp(-k*days_since_last_seen). 0=off. ~0.0077 ≈ 90-day half-life. Calibrate first.
QSEARCH_ULTRA_BROAD_MIN_TRUST=0 # Require this trust_score before an ultra-broad corpus hit short-circuits a paid sweep. 0=off (BM25 score only).
# QSEARCH_QUALITY_TRUST_SATURATION=2  # Trust normalization saturation in the quality gate. Set to corpus p90 (scripts/corpus_percentile_analysis.js).

# ── Tier 3 — observability ──
QSEARCH_LOG_LEVEL=info          # debug | info | warn | error
QSEARCH_LOG_JSON=false          # true → structured JSON log lines for aggregators.
